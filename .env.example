# ==============================================================================
# JioFiber Asterisk Global PBX Environment Variables
# Rename this file to .env before starting docker compose: cp .env.example .env
# ==============================================================================

# Your fixed line Jio number including country code (e.g. +912212345678)
JIO_LANDLINE_NUMBER=+91XXXXXXXXXX

# Password for Softphone Extension 1001 (e.g. Your Mobile Phone)
EXT_1001_PASSWORD=ChangeThisSecretKey123!

# Password for Softphone Extension 1002 (e.g. Laptop / Secondary Device)
EXT_1002_PASSWORD=ChangeThisSecondSecretKey456!

# Public IPv4 address of your VPS
VPS_PUBLIC_IP=123.45.67.89
